#include "common.h"
#include "ogsr_ssgi_light.h"

uniform float4 m_affects;

SSGILightOutput main(p_flat I) SSGI_LIGHT_SEMANTIC
{
    // diffuse
    float3 D = s_base.Sample(smp_base, I.tcdh); // IN:  rgb.a
    D = SRGBToLinear(D);

    float brightness = 1.0 - m_affects.x - m_affects.x;
    return SSGIPackLight(float4(D.rgb, brightness), float4(D.rgb, brightness));
}

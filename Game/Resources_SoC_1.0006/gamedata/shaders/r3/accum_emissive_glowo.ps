#include "common.h"
#include "ogsr_ssgi_light.h"
#include "sload.h"

float4 pda_params;

SSGILightOutput main(p_flat I) SSGI_LIGHT_SEMANTIC
{
    // diffuse
    float3 D = tbase(I.tcdh); // IN:  rgb.a
    D = SRGBToLinear(D);

    float brightness = 0.1f;
    float4 color = float4(D.rgb, 1);
    color *= float4(brightness, brightness, brightness, brightness);

    return SSGIPackLight(color, color);
}

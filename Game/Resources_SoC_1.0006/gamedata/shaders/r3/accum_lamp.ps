#include "common.h"
#include "ogsr_ssgi_light.h"

SSGILightOutput main(p_flat I) SSGI_LIGHT_SEMANTIC
{
    // diffuse
    float3 D = s_base.Sample(smp_base, I.tcdh); // IN:  rgb.a
    D = SRGBToLinear(D);

    float brightness = 2.0;
    float4 color = float4(D.rgb, 1.0);

    return SSGIPackLight(color * brightness, color * brightness);
}

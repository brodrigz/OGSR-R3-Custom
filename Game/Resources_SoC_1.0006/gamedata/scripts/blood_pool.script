	-- [clsid.pseudodog_s] 			= dog,
	-- [clsid.psy_dog_s] 				= dog,
	-- [clsid.psy_dog_phantom_s] 		= dog,
	-- [clsid.cat_s] 					= cat,
	-- [clsid.rat] 					= rat,
	-- [clsid.rat_s]					= rat,
	-- [clsid.controller_s] 			= controller,
	-- [clsid.fracture_s] 				= fracture,
	-- [clsid.poltergeist_s] 			= poltergeist,

-- Adapted for Radiophobia 3.
-- seaz5150 31/05/2024

function attach( sm )
  --sm:subscribe({ signal = "on_death", fun = this.actor_on_before_death }) -- screen blacks out anyway
  sm:subscribe({ signal = "on_update", fun = this.actor_on_update })
  sm:subscribe({ signal = "on_footstep", fun = this.actor_on_footstep })
  sm:subscribe({ signal = "on_monster_death", fun = this.on_death_callback })
  sm:subscribe({ signal = "on_npc_death", fun = this.on_death_callback })
  sm:subscribe({ signal = "on_npc_spawn", fun = this.on_npc_spawn })
  sm:subscribe({ signal = "on_npc_death", fun = this.on_death     })
end

function on_npc_spawn( obj, binder )
  if not obj:alive() then return end

  local s = {
    [ "signal" ] = "on_npc_update." .. obj:id(),
    [ "fun"    ] = this.npc_on_update,
    [ "queued" ] = true,
  }
  binder[ script_name() .. ".subscribed" ] = s
  ogse_signals.get_mgr():subscribe( s )
end

function on_death( obj )
  local binder = obj:binded_object()
  local s      = binder[ script_name() .. ".subscribed" ]
  if s then
    ogse_signals.get_mgr():unsubscribe( s )
    binder[ script_name() .. ".subscribed" ] = nil
  end
end

local settings = {
		["max_pool_size"] = 0.85,
		["num_of_updates"] = 1000,
		["update_freq"] = 25,
		["pool_lifetime"] = 500000,
}

-- UTILS
local function vecSimilar(v1, v2, eps)
	eps = eps or 0.4
	local abs = math.abs
	return abs(v1.x - v2.x) < eps and abs(v1.y - v2.y) < eps and abs(v1.z - v2.z) < eps 
end

local enable_debug = false
local function printf(...)
	if enable_debug then
		_G.printf(...)
	end
end

pool_starts_in = 5000
blood_textures_amount = 24
pool_size_mult = {
	-- clsid
	-- [clsid.boar_s] 					= boar,
	-- [clsid.flesh_s] 				= flesh,
	-- [clsid.burer_s] 				= burer,

--Меню настроек геймплея. Используется скриптом ui_mm_opt_main.script

local function bind_hint(handler, wnd, id, title_id, hint_id)
	if not wnd then
		return
	end
	handler:Register(wnd, id)
	handler:AddCallback(id, ui_events.STATIC_FOCUS_RECEIVED, function()
		if handler.hint_name then
			handler.hint_name:SetText(game.translate_string(title_id))
		end
		if handler.hint_caption then
			handler.hint_caption:SetText(game.translate_string(hint_id))
		end
	end)
end

local function fs_has_file(path, name)
	local fs = getFS()
	if not fs then
		return false
	end
	local ok, info = pcall(function()
		return fs:exist(path, name)
	end)
	if not ok or info == nil or type(info) == "number" then
		return false
	end
	local found = false
	pcall(function()
		local sz = tonumber(info.size_real) or 0
		local nm = string.lower(info.name and tostring(info.name) or "")
		local leaf = string.lower(string.match(name, "[^\\/]+$") or name)
		found = sz > 0 and leaf ~= "" and string.find(nm, leaf, 1, true) ~= nil
	end)
	return found
end

local function sebs_backpack_available()
	return fs_has_file("$game_scripts$", "hoc_backpack_inventory_anim.script")
		and fs_has_file("$game_config$", "misc\\hud_items\\hoc_backpack.ltx")
end

local function add_hint(handler, id, title_id, hint_id)
	handler:AddCallback(id, ui_events.STATIC_FOCUS_RECEIVED, function()
		if handler.hint_name then
			handler.hint_name:SetText(game.translate_string(title_id))
		end
		if handler.hint_caption then
			handler.hint_caption:SetText(game.translate_string(hint_id))
		end
	end)
end

class "opt_gameplay" (CUIWindow)
function opt_gameplay:__init() super()
end

function opt_gameplay:__finalize()
end

function opt_gameplay:InitControls(x, y, xml, handler)
	self:Init(x, y, 450, 454)
	self:SetAutoDelete(true)

	xml:InitFrameLine("tab_gameplay:cap_sec_difficulty", self)
	xml:InitFrameLine("tab_gameplay:cap_sec_combat", self)
	xml:InitFrameLine("tab_gameplay:cap_sec_world", self)
	xml:InitFrameLine("tab_gameplay:cap_sec_immersion", self)

	bind_hint(handler, xml:InitStatic("tab_gameplay:list_difficulty_cap", self), "gp_cap_difficulty", "st_cap_list_difficulty", "ui_mm_hint_difficulty")
	bind_hint(handler, xml:InitStatic("tab_gameplay:list_economy_cap", self), "gp_cap_economy", "st_cap_list_economy", "ui_mm_hint_economy")
	bind_hint(handler, xml:InitStatic("tab_gameplay:list_bullet_pen_cap", self), "gp_cap_bullet_pen", "ui_mm_bullet_penetration", "ui_mm_hint_bullet_pen")

	bind_hint(handler, xml:InitCheck("tab_gameplay:check_auto_aim_zoom", self), "gp_auto_aim_zoom", "ui_mm_auto_aim_zoom", "ui_mm_hint_auto_aim_zoom")
	bind_hint(handler, xml:InitCheck("tab_gameplay:check_late_reload", self), "gp_late_reload", "ui_mm_late_reload", "ui_mm_hint_late_reload")
	bind_hint(handler, xml:InitCheck("tab_gameplay:check_switch_slot", self), "gp_switch_slot", "ui_mm_switch_slot", "ui_mm_hint_switch_slot")
	bind_hint(handler, xml:InitCheck("tab_gameplay:check_sprint_lower_weapon", self), "gp_sprint_lower", "ui_mm_sprint_lower_weapon", "ui_mm_hint_sprint_lower_weapon")
	bind_hint(handler, xml:InitCheck("tab_gameplay:check_sticky_aim", self), "gp_sticky_aim", "ui_mm_sticky_aim", "ui_mm_hint_sticky_aim")

	ledge_grab = xml:InitCheck("tab_gameplay:check_ledge_grab", self)
	handler:Register(ledge_grab, "ledge_grab")
	local ledge_on = ui_data.load("rad3_ledge_grab")
	if ledge_on == nil then ledge_on = true end
	ledge_grab:SetCheck(ledge_on)
	handler:AddCallback("ledge_grab", ui_events.BUTTON_CLICKED, self.LedgeGrab, self)
	add_hint(handler, "ledge_grab", "ui_mm_ledge_grab", "ui_mm_hint_ledge_grab")

	bind_hint(handler, xml:InitCheck("tab_gameplay:check_autopause", self), "gp_autopause", "ui_mm_keypress_on_start", "ui_mm_hint_autopause")
	bind_hint(handler, xml:InitCheck("tab_gameplay:check_ambient", self), "gp_ambient", "ui_mm_ambient", "ui_mm_hint_ambient")

	use_anims = xml:InitCheck("tab_gameplay:check_use_anims", self)
	handler:Register(use_anims, "use_anims")
	use_anims:SetCheck(ui_data.load("rad3_use_anims"))
	handler:AddCallback("use_anims", ui_events.BUTTON_CLICKED, self.UseAnims, self)
	add_hint(handler, "use_anims", "ui_mm_use_anims", "ui_mm_hint_use_anims")

	harvest_anim = xml:InitCheck("tab_gameplay:check_harvest_anim", self)
	handler:Register(harvest_anim, "harvest_anim")
	harvest_anim:SetCheck(ui_data.load("rad3_harvest_anim"))
	handler:AddCallback("harvest_anim", ui_events.BUTTON_CLICKED, self.HarvestAnim, self)
	add_hint(handler, "harvest_anim", "ui_mm_harvest_anim", "ui_mm_hint_harvest_anim")

	mutants_after_blowout = xml:InitCheck("tab_gameplay:check_mutants_after_blowout", self)
	handler:Register(mutants_after_blowout, "mutants_after_blowout")
	mutants_after_blowout:SetCheck(ui_data.load("rad3_mutants_after_blowout"))
	handler:AddCallback("mutants_after_blowout", ui_events.BUTTON_CLICKED, self.MutantsAfterBlowout, self)
	add_hint(handler, "mutants_after_blowout", "ui_mm_mutants_after_blowout", "ui_mm_hint_mutants_after_blowout")

	gasmask_breath_snd = xml:InitCheck("tab_gameplay:check_gasmask_breath_snd", self)
	handler:Register(gasmask_breath_snd, "gasmask_breath_snd")
	gasmask_breath_snd:SetCheck(ui_data.load("rad3_gasmask_breath_snd"))
	handler:AddCallback("gasmask_breath_snd", ui_events.BUTTON_CLICKED, self.GasmaskBreathSnd, self)
	add_hint(handler, "gasmask_breath_snd", "ui_mm_gasmask_breath_snd", "ui_mm_hint_gasmask_breath_snd")

	legs = xml:InitCheck("tab_gameplay:check_legs", self)
	handler:Register(legs, "legs")
	legs:SetCheck(ui_data.load("rad3_legs"))
	handler:AddCallback("legs", ui_events.BUTTON_CLICKED, self.Legs, self)
	add_hint(handler, "legs", "ui_mm_legs", "ui_mm_hint_legs")

	dynamic_news = xml:InitCheck("tab_gameplay:check_dynamic_news", self)
	handler:Register(dynamic_news, "dynamic_news")
	dynamic_news:SetCheck(ui_data.load("rad3_dynamic_news"))
	handler:AddCallback("dynamic_news", ui_events.BUTTON_CLICKED, self.DynamicNews, self)
	add_hint(handler, "dynamic_news", "ui_mm_dynamic_news", "ui_mm_hint_dynamic_news")

	autounload_wpn = xml:InitCheck("tab_gameplay:check_autounload_wpn", self)
	handler:Register(autounload_wpn, "autounload_wpn")
	autounload_wpn:SetCheck(ui_data.load("rad3_autounload_wpn"))
	handler:AddCallback("autounload_wpn", ui_events.BUTTON_CLICKED, self.AutounloadWpn, self)
	add_hint(handler, "autounload_wpn", "ui_mm_autounload_wpn", "ui_mm_hint_autounload_wpn")

	pickup_anim = xml:InitCheck("tab_gameplay:check_pickup_anim", self)
	handler:Register(pickup_anim, "pickup_anim")
	pickup_anim:SetCheck(ui_data.load("rad3_pickup_anim"))
	handler:AddCallback("pickup_anim", ui_events.BUTTON_CLICKED, self.PickupAnim, self)
	add_hint(handler, "pickup_anim", "ui_mm_pickup_anim", "ui_mm_hint_pickup_anim")

	hit_snd = xml:InitCheck("tab_gameplay:check_hit_snd", self)
	handler:Register(hit_snd, "hit_snd")
	hit_snd:SetCheck(ui_data.load("rad3_hit_snd"))
	handler:AddCallback("hit_snd", ui_events.BUTTON_CLICKED, self.HitSnd, self)
	add_hint(handler, "hit_snd", "ui_mm_hit_snd", "ui_mm_hint_hit_snd")

	backpack_anim = nil
	if sebs_backpack_available() then
		backpack_anim = xml:InitCheck("tab_gameplay:check_backpack_anim", self)
		handler:Register(backpack_anim, "backpack_anim")
		local on = ui_data.load("rad3_backpack_anim")
		if on == nil then on = true end
		backpack_anim:SetCheck(on)
		handler:AddCallback("backpack_anim", ui_events.BUTTON_CLICKED, self.BackpackAnim, self)
		add_hint(handler, "backpack_anim", "ui_mm_backpack_anim", "ui_mm_hint_backpack_anim")
	end

	task_autosave = xml:InitCheck("tab_gameplay:check_task_autosave", self)
	handler:Register(task_autosave, "task_autosave")
	task_autosave:SetCheck(ui_data.load("rad3_task_autosave"))
	handler:AddCallback("task_autosave", ui_events.BUTTON_CLICKED, self.TaskAutosave, self)
	add_hint(handler, "task_autosave", "ui_mm_task_autosave", "ui_mm_hint_task_autosave")

	list_difficulty = xml:InitComboBox("tab_gameplay:list_difficulty", self)
	list_difficulty:SetAutoDelete(true)
	handler:Register(list_difficulty, "list_difficulty")
	handler:AddCallback("list_difficulty", ui_events.LIST_ITEM_SELECT, self.DifficultySelect, self)

	list_economy = xml:InitComboBox("tab_gameplay:list_economy", self)
	list_economy:SetAutoDelete(true)
	handler:Register(list_economy, "list_economy")
	handler:AddCallback("list_economy", ui_events.LIST_ITEM_SELECT, self.EconomySelect, self)

	xml:InitComboBox("tab_gameplay:list_bullet_pen", self)

	local btn = xml:Init3tButton("tab_gameplay:btn_default", self)
	handler:Register(btn, "btn_game_default")
end

function opt_gameplay:DifficultySelect()
	local diff_id = list_difficulty:CurrentID() + 1
	get_console():execute("g_rad3_game_diff gdiff_" .. diff_id)
	game_difficulties.set_game_factor("type", diff_id)
end

function opt_gameplay:EconomySelect()
	local diff_id = list_economy:CurrentID() + 1
	get_console():execute("g_rad3_economy_diff econ_" .. diff_id)
	game_difficulties.set_eco_factor("type", diff_id)
end

function opt_gameplay:UseAnims()
	use_anims:SetCheck(ui_data.load("rad3_use_anims"))
	if use_anims:GetCheck() then
		ui_data.save("rad3_use_anims", false)
		use_anims:SetCheck(false) else
		ui_data.save("rad3_use_anims", true)
		use_anims:SetCheck(true)
	end
end


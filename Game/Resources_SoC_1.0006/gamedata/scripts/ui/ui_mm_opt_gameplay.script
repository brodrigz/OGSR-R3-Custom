local function set_rad3_check(ctrl, key, value)
	ui_data.save(key, value)
	if ctrl then
		ctrl:SetCheck(value)
	end
end

function opt_gameplay:LedgeGrab()
	local on = ui_data.load("rad3_ledge_grab")
	if on == nil then on = true end
	ledge_grab:SetCheck(on)
	if ledge_grab:GetCheck() then
		ui_data.save("rad3_ledge_grab", false)
		ledge_grab:SetCheck(false) else
		ui_data.save("rad3_ledge_grab", true)
		ledge_grab:SetCheck(true)
	end
end

function opt_gameplay:ResetToDefaults()
	cmd("g_rad3_game_diff gdiff_2")
	cmd("g_rad3_economy_diff econ_2")
	cmd("g_bullet_penetration st_bullet_pen_on")
	cmd("g_auto_aim_zoom off")
	cmd("g_complete_late_reload_on_hide on")
	cmd("g_mouse_wheel_switch_slot off")
	cmd("g_sprint_lower_weapon off")
	cmd("g_sticky_aim off")
	cmd("keypress_on_start on")
	cmd("g_music_tracks on")

	if game_difficulties then
		game_difficulties.set_game_factor("type", 2)
		game_difficulties.set_eco_factor("type", 2)
	end

	set_rad3_check(task_autosave, "rad3_task_autosave", true)
	set_rad3_check(mutants_after_blowout, "rad3_mutants_after_blowout", true)
	set_rad3_check(dynamic_news, "rad3_dynamic_news", true)
	set_rad3_check(autounload_wpn, "rad3_autounload_wpn", false)
	set_rad3_check(pickup_anim, "rad3_pickup_anim", true)
	set_rad3_check(use_anims, "rad3_use_anims", true)
	set_rad3_check(harvest_anim, "rad3_harvest_anim", true)
	set_rad3_check(legs, "rad3_legs", true)
	set_rad3_check(gasmask_breath_snd, "rad3_gasmask_breath_snd", true)
	set_rad3_check(hit_snd, "rad3_hit_snd", true)
	if backpack_anim and backpack_anim:IsShown() then
		set_rad3_check(backpack_anim, "rad3_backpack_anim", true)
	end
	set_rad3_check(ledge_grab, "rad3_ledge_grab", true)

	local opt = COptionsManager()
	opt:SetCurrentValues("mm_opt_gameplay")
	opt:SetCurrentValues("random")
end

class "opt_input_behavior" (CUIWindow)
function opt_input_behavior:__init() super()
end

function opt_input_behavior:__finalize()
end

function opt_input_behavior:InitControls(x, y, xml, handler)
	self:Init(x, y, 450, 410)
	self:SetAutoDelete(true)

	xml:InitFrameLine("tab_input_behavior:cap_sec_modes", self)
	for _, id in ipairs({"aim", "sprint", "lean", "crouch", "walk", "low_crouch"}) do
		bind_hint(handler, xml:InitStatic("tab_input_behavior:cap_" .. id, self), "input_cap_" .. id,
			"ui_mm_input_" .. id, "ui_mm_hint_input_" .. id)
		xml:InitComboBox("tab_input_behavior:list_" .. id, self)
	end

	local btn = xml:Init3tButton("tab_input_behavior:btn_default", self)
	handler:Register(btn, "btn_input_default")
end

function opt_input_behavior:ResetToDefaults()
	cmd("g_aim_input_mode st_input_hold")
	cmd("g_sprint_input_mode st_input_toggle")
	cmd("g_lean_input_mode st_input_hold")
	cmd("g_crouch_input_mode st_input_hold")
	cmd("g_walk_input_mode st_input_toggle")
	cmd("g_low_crouch_input_mode st_input_toggle")
end

class "opt_hud" (CUIWindow)
function opt_hud:__init() super()
end

function opt_hud:__finalize()
end

function opt_hud:InitControls(x, y, xml, handler)
	self:Init(x, y, 450, 410)
	self:SetAutoDelete(true)

	xml:InitFrameLine("tab_hud:cap_sec_display", self)
	xml:InitFrameLine("tab_hud:cap_sec_compass", self)
	xml:InitFrameLine("tab_hud:cap_sec_minimap", self)

	bind_hint(handler, xml:InitCheck("tab_hud:check_crosshair", self), "hud_crosshair", "ui_mm_show_crosshair", "ui_mm_hint_crosshair")
	bind_hint(handler, xml:InitCheck("tab_hud:check_crosshair_hard", self), "hud_crosshair_hard", "ui_mm_crosshair_hard", "ui_mm_hint_crosshair_hard")
	bind_hint(handler, xml:InitCheck("tab_hud:check_dist", self), "hud_dist", "ui_mm_crosshair_distance", "ui_mm_hint_dist")
	bind_hint(handler, xml:InitCheck("tab_hud:check_hud_interact", self), "hud_interact_opt", "ui_mm_hud_interact", "ui_mm_hint_hud_interact")
	bind_hint(handler, xml:InitCheck("tab_hud:check_tips", self), "hud_tips", "ui_mm_tips", "ui_mm_hint_tips")
	bind_hint(handler, xml:InitCheck("tab_hud:check_3d_pda", self), "hud_3d_pda", "ui_mm_3d_pda", "ui_mm_hint_3d_pda")

	fakelens = xml:InitCheck("tab_hud:check_fakelens", self)
	handler:Register(fakelens, "fakelens")
	fakelens:SetCheck(ui_data.load("rad3_fakelens"))
	handler:AddCallback("fakelens", ui_events.BUTTON_CLICKED, self.Fakelens, self)
	add_hint(handler, "fakelens", "ui_mm_fakelens", "ui_mm_hint_fakelens")

	local function load_flag(key)
		local on = ui_data.load(key)
		if on == nil then return true end
		return on
	end

	dialog_ui = xml:InitCheck("tab_hud:check_dialog_ui", self)
	handler:Register(dialog_ui, "dialog_ui")
	dialog_ui:SetCheck(load_flag("rad3_dialog_ui"))
	handler:AddCallback("dialog_ui", ui_events.BUTTON_CLICKED, self.DialogUi, self)
	add_hint(handler, "dialog_ui", "ui_mm_dialog_ui", "ui_mm_hint_dialog_ui")

	bind_hint(handler, xml:InitStatic("tab_hud:list_compass_cap", self), "hud_cap_compass", "ui_mm_tactical_compass", "ui_mm_hint_compass")
	bind_hint(handler, xml:InitStatic("tab_hud:cap_compass_pos", self), "hud_cap_compass_pos", "ui_mm_compass_pos", "ui_mm_hint_compass_pos")
	bind_hint(handler, xml:InitStatic("tab_hud:cap_compass_range", self), "hud_cap_compass_range", "ui_mm_compass_range", "ui_mm_hint_compass_range")
	bind_hint(handler, xml:InitStatic("tab_hud:cap_compass_scale", self), "hud_cap_compass_scale", "ui_mm_compass_scale", "ui_mm_hint_compass_scale")
	bind_hint(handler, xml:InitStatic("tab_hud:cap_compass_x", self), "hud_cap_compass_x", "ui_mm_compass_x", "ui_mm_hint_compass_x")
	bind_hint(handler, xml:InitStatic("tab_hud:cap_compass_y", self), "hud_cap_compass_y", "ui_mm_compass_y", "ui_mm_hint_compass_y")
	xml:InitTrackBar("tab_hud:track_compass_range", self)
	xml:InitTrackBar("tab_hud:track_compass_scale", self)
	xml:InitTrackBar("tab_hud:track_compass_x", self)
	xml:InitTrackBar("tab_hud:track_compass_y", self)

	bind_hint(handler, xml:InitStatic("tab_hud:cap_minimap_pos", self), "hud_cap_minimap_pos", "ui_mm_minimap_pos", "ui_mm_hint_minimap_pos")
	bind_hint(handler, xml:InitStatic("tab_hud:cap_minimap_scale", self), "hud_cap_minimap_scale", "ui_mm_minimap_scale", "ui_mm_hint_minimap_scale")
	bind_hint(handler, xml:InitStatic("tab_hud:cap_minimap_x", self), "hud_cap_minimap_x", "ui_mm_minimap_x", "ui_mm_hint_minimap_x")
	bind_hint(handler, xml:InitStatic("tab_hud:cap_minimap_y", self), "hud_cap_minimap_y", "ui_mm_minimap_y", "ui_mm_hint_minimap_y")
	xml:InitTrackBar("tab_hud:track_minimap_scale", self)
	xml:InitTrackBar("tab_hud:track_minimap_x", self)
	xml:InitTrackBar("tab_hud:track_minimap_y", self)
	xml:InitStatic("tab_hud:cap_font_scale_x", self)
	xml:InitTrackBar("tab_hud:track_font_scale_x", self)
	xml:InitStatic("tab_hud:cap_font_scale_y", self)
	xml:InitTrackBar("tab_hud:track_font_scale_y", self)

	xml:InitComboBox("tab_hud:list_compass", self)
	xml:InitComboBox("tab_hud:list_compass_pos", self)
	xml:InitComboBox("tab_hud:list_minimap_pos", self)

	local btn = xml:Init3tButton("tab_hud:btn_default", self)
	handler:Register(btn, "btn_hud_default")
end

function opt_hud:Fakelens()
	fakelens:SetCheck(ui_data.load("rad3_fakelens"))
	if fakelens:GetCheck() then
		ui_data.save("rad3_fakelens", false)
		fakelens:SetCheck(false) else
		ui_data.save("rad3_fakelens", true)
		fakelens:SetCheck(true)
	end
end

local function toggle_hud_flag(ctrl, key)
	local on = ui_data.load(key)
	if on == nil then on = true end
	ctrl:SetCheck(on)
	if ctrl:GetCheck() then
		ui_data.save(key, false)
		ctrl:SetCheck(false)
	else
		ui_data.save(key, true)
		ctrl:SetCheck(true)
	end
end

function opt_hud:DialogUi()
	toggle_hud_flag(dialog_ui, "rad3_dialog_ui")
end

function opt_hud:ResetToDefaults()
	cmd("hud_crosshair on")
	cmd("hud_crosshair_hard off")
	cmd("hud_crosshair_dist off")
	cmd("hud_interact on")
	cmd("hud_info on")
	cmd("g_3d_pda on")
	cmd("g_tactical_compass st_compass_classic")
	cmd("g_tactical_compass_pos st_compass_pos_bottom")
	cmd("g_tactical_compass_range 150")
	cmd("g_tactical_compass_scale 1")
	cmd("g_tactical_compass_x 0")
	cmd("g_tactical_compass_y 0")
	cmd("g_minimap_pos st_minimap_pos_bl")
	cmd("g_minimap_scale 1")
	cmd("g_minimap_x 0")
	cmd("g_minimap_y 0")
	cmd("g_font_scale_x 1")
	cmd("g_font_scale_y 1")

	ui_data.save("rad3_fakelens", true)
	if fakelens then
		fakelens:SetCheck(true)
	end
	ui_data.save("rad3_dialog_ui", true)
	if dialog_ui then dialog_ui:SetCheck(true) end

	local opt = COptionsManager()
	opt:SetCurrentValues("mm_opt_gameplay")
end

class "text_item" (CUIListItemEx)
function text_item:__init() super()
	self.fn= CUIStatic()
	self.fn:SetTextColor(255, 184, 184, 184)
	self.fn:SetAutoDelete(true)
	self:AttachChild(self.fn)
	self.fn:SetText("item")
end

function actor_binder:on_item_take (obj)
    level_tasks.proceed(self.object)
	if rx_ai then rx_ai.actor_item_take(obj) end
    --game_stats.update_take_item (obj, self.object)
	--************************************
	m_bar.take_item(obj)
	--************************************	
